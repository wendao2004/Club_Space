# ============================================================================
# 环境变量模板
#
# 复制成 .env 后填写真实值。**.env 绝不进 git** —— 里面有会话密钥。
# 评审团把"compose / .env 纳入 git"列为 blocker，因为 .env 必然含密钥。
#
# 这个文件里**每一项都有可用的默认值**，所以理论上 `cp .env.example .env`
# 之后只填 WL_SESSION_SECRET 就能起来。但下面标了 ⚠️ 的几项在本机部署时
# 基本都得改 —— 尤其是 IP 和端口。
# ============================================================================

# ---- 必填 ----
# 会话签名密钥。至少 32 个字符。
# 生成方式（在任意有 node 的机器上跑）：
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# 这个值缺失时后端在生产环境会**拒绝启动**（而不是偷偷用一个随机值）——
# 因为每次重启都换密钥会让所有人反复掉线，而没人会发现配置缺失。
WL_SESSION_SECRET=

# ---- 站点 ----
WL_SITE_NAME=社团空间

# ---- 访问地址与端口 ----
# ⚠️ 这两项基本一定要按实际情况改。
#
# 为什么不用 80/443：很多 NAS 把这两个端口留给自己的 Web 管理界面
# （飞牛 fnOS 的 nginx 同时占着 80、443、5666）。绑上去会直接
# "address already in use"。所以主站跑在高位端口。
#
# ⚠️ 只有两项，而且**只需要保证这一项对你可用**：
#     WL_HTTPS_PORT   = 主站对外端口（Caddy 容器内外用的是同一个值）
#     WL_ONBOARD_PORT = 明文引导页端口
#
# WL_ONBOARD_BASE 里要把 192.168.1.100 换成你 NAS 的实际 IP —— 它是引导页
# 重定向的完整地址（不能从请求里推，因为 location.hostname 会丢掉端口）。
#
# ⚠️ 部署前先确认端口没被占：`ss -tln | grep -E ':(9443|8080) '`。
#    80/443 通常被系统界面占了；8443 这类"常用替代端口"也很容易被别的服务占
#    （本机实测就被一个 code-server 占了）。被占的表现是 wl-caddy 起不来并报
#    "address already in use"。
#
# ⚠️ 证书里必须包含你这个 IP，否则浏览器会因为主机名不匹配而告警。
#    见 deploy/ca/gen-certs.sh 的 WL_HOST_IP。
WL_HTTPS_PORT=9443
WL_ONBOARD_PORT=8080
WL_ONBOARD_BASE=http://192.168.1.100:8080

# ---- 存储 ----
# 数据目录：SQLite 库、上传的文件、临时文件都在这里。
# 建议指向 NAS 上的共享目录，便于用同一次快照覆盖"库 + 文件"做一致性备份。
#
# ⚠️ 属主必须对得上。容器里的进程以 uid 10001 运行（见 deploy/Dockerfile），
#    而这个目录是宿主机上的绑定挂载 —— 宿主机上的属主说了算，镜像里
#    建目录时的 chown 会被挂载完全盖掉。属主不对时容器能起来但**写不进数据**，
#    表现为建账号/传文件直接 500。部署前先执行一次：
#        sudo mkdir -p /vol1/docker/wl-club/data
#        sudo chown -R 10001:10001 /vol1/docker/wl-club/data
WL_DATA_DIR=/vol1/docker/wl-club/data

# 单文件上传上限（字节）。**0 = 不限，这也是默认值。**
#
# 原来默认 4GiB，但那个数字挡不住真正该挡的事（传 4 个大文件照样能写满盘），
# 却会把正常的大文件拒掉（一个 5GB 的活动录像）。所以默认关掉，
# 改由下面的磁盘余量守卫来保护机器 —— 那个才对应"别把盘写满"。
# 只有当你确实想设个上限时才改成非 0。
WL_MAX_UPLOAD_BYTES=0

# 上传后必须保留的磁盘余量（字节），默认 2GiB。
#
# 这是取代"单文件上限"的那道闸门：上传前算「可用空间 − 本次要写的字节 ≥ 本值」，
# 不满足就拒绝并告诉你还剩多少。留一截是必需的 —— 这块盘上还跑着 SQLite、
# Docker 日志和 fnOS 自己，把盘写满会连带把系统服务一起弄挂。
# 设成 0 就完全关掉（不建议）。
WL_MIN_FREE_BYTES=2147483648

# ---- 工具集 ----
WL_TOOLS_ENABLED=true

# 重任务服务地址（LibreOffice 转换 / ffmpeg 转码）。
# 留空时相关工具在界面上显示为"未启用"并说明原因，而不是静默失败。
# 部署了 deploy/heavy-tools.compose.yml 之后再填，例如：
#   WL_CONVERT_SERVICE_URL=http://wl-convert:3000
WL_CONVERT_SERVICE_URL=

# ---- 应用容器资源上限 ----
# 整机 8GB，fnOS 自身 + Samba + 相册索引 + 影视转码长期占 2-5GB，
# 留给业务容器的只有 2-4GB。这两个值被 docker-compose.yml 直接引用，
# 调大之前先 `docker stats --no-stream` 看看实际余量。
WL_APP_MEMORY=512m
WL_APP_CPUS=1.5

# ---- 管理员运维管控（默认关闭）----
# 打开之前请先读 docs/部署指南.md 的「启用管理员运维」一节。
# 一句话总结风险：能操作 Docker = 能拿到宿主机 root。
# 所以默认关闭，且启用后要求 TOTP 二次验证 + 参数白名单。
#
# 开关有两层，两层都要动才会真正生效：
#   1. 这份 .env 里的 WL_ADMIN_DOCKER_ENABLED=1
#   2. 启动时带上 admin profile：docker compose --profile admin up -d
#      （执行器容器在 compose 里被放进 admin profile，默认不会起来 ——
#        否则"默认关闭"这句话就是假的）
WL_ADMIN_DOCKER_ENABLED=0

# 执行器令牌。启用运维管控时**必须**设置，生成方式：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 留空时执行器会拒绝启动（它宁可起不来，也不做一个没有鉴权的
# "执行任意 docker 命令"的服务）。app 与 ops-runner 两边共用这一个值。
WL_ADMIN_RUNNER_TOKEN=

# 执行器地址。一般不用改 —— 这是 compose 内部的服务名，
# 只有当执行器跑在别的主机上时才需要改。
WL_ADMIN_RUNNER_URL=http://ops-runner:9119

# 宿主机 docker 组的 GID。**启用运维管控时必填，而且要填对。**
# 获取方式（在 NAS 上执行）：getent group docker | cut -d: -f3
# 常见值是 999 / 994 / 998，各发行版不一样，不要猜。
#
# 为什么需要：执行器容器里的进程以非 root 用户运行，而宿主机的
# /var/run/docker.sock 是 root:docker 0660 —— 只有把宿主机的 docker 组
# 附加进容器，进程才打得开这个 socket。填错的表现是"运维页面里每个操作
# 都报 permission denied"，看起来像平台 bug，其实是配置。
WL_DOCKER_GID=994

# 构建 ops-runner 镜像时用的 apk 源。**留空 = 官方源**（Fastly CDN）。
#
# 国内网络下官方源常常慢到构建卡死：本项目实测下一个小索引文件要 1 分 45 秒，
# `docker compose build ops-runner` 十几分钟没有任何输出，看起来像挂了。
# 换成国内镜像后同一文件 0.25 秒：
#   WL_APK_MIRROR=https://mirrors.aliyun.com
#
# 只在**首次构建执行器镜像**时需要；镜像建好之后改动这个值没有影响。
WL_APK_MIRROR=

# 应用镜像的 tag。**由 deploy/upgrade.sh 自动维护，不要手改**（手改的唯一
# 正当理由是回滚：把这里换成一个旧的 prev-<时间戳>，再 `docker compose up -d app`）。
#
# 为什么需要它：原来 compose 里写死 `wl-club/app:1`，每次 `up -d --build` 都用
# 新镜像覆盖同一个 tag，旧镜像从此没有任何引用指向它 —— 新版本出问题想退回上一版，
# 只能 `git checkout <旧 commit>` 重新构建，而你未必记得上一版是哪个 commit。
#
# 留空（= 默认 latest）时 `docker compose up -d --build` 仍可用，只是不可回滚；
# 生产升级请走 `./upgrade.sh`（先备份、打时间戳 tag、起容器、验健康）。
WL_IMAGE_TAG=

# 允许从网页上启停的服务白名单（逗号分隔）。**默认为空。**
#
# ⚠️ 这里填的必须是 **deploy/docker-compose.yml 里真实存在的服务名**、
#    而不是容器名。主文件里只有 caddy / app / ops-runner，而且这三个都不该
#    从网页上停：停 app 或 caddy 就失去访问入口，停 ops-runner 就失去运维页本身。
#    所以默认留空；只有你自己往主文件里加了别的服务、停掉也无所谓时才填。
#
# ⚠️ **不要填 convert。** 转换服务定义在另一份编排
#    （deploy/heavy-tools.compose.yml），运维页固定只操作主文件，
#    填了它只会得到一个点下去必然失败的按钮（no such service: convert）。
#    按需拉起转换服务的命令见 docs/部署指南.md 第 9 节。
WL_ADMIN_ALLOWED_SERVICES=

# 可选：限制来源 IP（逗号分隔）。内网平台建议填管理员的固定 IP，
# 这样即使管理员的会话被劫持，攻击者从别的机器也用不了。
WL_ADMIN_ALLOWED_IPS=

# 单个运维命令的超时（毫秒）
WL_ADMIN_TIMEOUT_MS=30000

# ---- 反向代理信任（安全相关，别留空）----
# 只信任真实反向代理的地址。留空表示"不信任任何代理"，此时 req.ip 是直连地址。
#
# ⚠️ 为什么不能简单地"全都信任"：如果无条件采用 X-Forwarded-For，
#    那么按 IP 的限流和管理员来源 IP 白名单会同时失效 —— 攻击者每个请求
#    换一个伪造的 XFF 值，就落到全新的限流桶里，等于没有限流。
#
# 容器化部署（默认）填 docker 网络的网段，Caddy 与 app 都在这个网段里：
WL_TRUSTED_PROXIES=172.16.0.0/12

# 如果你把应用直接跑在宿主机上（没有反向代理），就留空：
# WL_TRUSTED_PROXIES=
