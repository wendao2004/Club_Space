{
  "name": "club-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "社团内网协作平台 —— 桌面式 Web 界面，自托管在局域网 NAS 上（Docker）",
  "license": "MIT",
  "author": "wendao2004",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendao2004/Club_Space.git"
  },
  "homepage": "https://github.com/wendao2004/Club_Space#readme",
  "bugs": {
    "url": "https://github.com/wendao2004/Club_Space/issues"
  },
  "keywords": [
    "self-hosted",
    "nas",
    "docker",
    "vue3",
    "fastify",
    "sqlite",
    "lan",
    "collaboration",
    "chinese-chess"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm -F @wl/server dev\" \"pnpm -F @wl/web dev\"",
    "build": "pnpm -F @wl/web build",
    "start": "pnpm -F @wl/server start",
    "typecheck": "pnpm -F @wl/server typecheck && pnpm -F @wl/web typecheck",
    "test": "node scripts/run-all-tests.mjs",
    "test:fast": "node scripts/run-all-tests.mjs --skip-ui"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
